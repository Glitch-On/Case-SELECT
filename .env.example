# ── Server ──────────────────────────────────────────────
PORT=3000

# ── SQL IDE database mode ──────────────────────────────
# prisma  = the PostgreSQL database below (default)
# dummy   = local SQLite sample database (optional, offline testing)
DB_MODE=prisma

# ── PostgreSQL connection string (primary) ─────────────
# Required when DB_MODE=prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# ── Dummy database (SQLite, optional) ──────────────────
# Only used when DB_MODE=dummy. Resolved relative to prisma-dummy/schema.prisma
DUMMY_DATABASE_URL="file:./dev.db"
