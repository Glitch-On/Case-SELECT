# ── Server ──────────────────────────────────────────────
PORT=3000

# ── SQL IDE database mode ──────────────────────────────
# dummy   = local SQLite sample database (default, no server needed)
# prisma  = the application's real database (PostgreSQL)
DB_MODE=dummy

# ── Dummy database (SQLite) ────────────────────────────
# Resolved relative to prisma-dummy/schema.prisma
DUMMY_DATABASE_URL="file:./dev.db"

# ── Real database (PostgreSQL) ─────────────────────────
# Required when DB_MODE=prisma. Left as a placeholder so Prisma CLI
# commands (e.g. prisma generate) work while the real DB is unconnected.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
