# ── Server ──────────────────────────────────────────────
PORT=3000

# ── SQL IDE database mode ──────────────────────────────
# prisma = the PostgreSQL database below (default and only mode).
# Accepted aliases: postgres, postgresql, pg, real.
DB_MODE=prisma

# ── PostgreSQL connection string (primary) ─────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
