// Dummy database schema for SQL IDE development/testing only.
// Generic sample tables — no application-specific assumptions.
// Replace with the real database (see database.md) when connecting.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-dummy"
}

datasource db {
  provider = "sqlite"
}

model Department {
  id           Int      @id @default(autoincrement())
  name         String
  location     String?
  createdAt    DateTime @default(now())

  employees Employee[]

  @@map("departments")
}

model Employee {
  id           Int         @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String      @unique
  jobTitle     String?
  salary       Float?
  hiredAt      DateTime    @default(now())
  departmentId Int?

  department   Department? @relation(fields: [departmentId], references: [id])
  orders       Order[]

  @@map("employees")
}

model Customer {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  city      String?
  createdAt DateTime @default(now())

  orders Order[]

  @@map("customers")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int     @default(0)

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id         Int         @id @default(autoincrement())
  status     String      @default("pending")
  total      Float       @default(0)
  createdAt  DateTime    @default(now())
  customerId Int
  employeeId Int?

  customer   Customer    @relation(fields: [customerId], references: [id])
  employee   Employee?   @relation(fields: [employeeId], references: [id])
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int @default(1)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
