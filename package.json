{
  "name": "case-select",
  "version": "1.0.0",
  "description": "A web game, where people are given crime puzzles where they solve it using SQL commands.",
  "main": "src/server.ts",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "db:dummy:migrate": "prisma migrate dev --schema prisma-dummy/schema.prisma --config prisma-dummy/prisma.config.ts",
    "db:dummy:seed": "node prisma-dummy/seed.ts",
    "db:dummy:setup": "npm run db:dummy:migrate && npm run db:dummy:seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShashankBadhautia/Case-SELECT.git"
  },
