# ── Frontend dev server ───────────────────────────────
# Vite serves the React app from here (npm run dev in ./frontend).
VITE_PORT=5173

# ── Backend API base URL ──────────────────────────────
# Where the frontend sends every API request. Must match the backend origin
# that is allowed by CORS in src/app.js (currently http://localhost:5173 is the
# allowed *frontend* origin; this value is the *backend* origin).
VITE_API_BASE_URL=http://localhost:3000

# ── Demo player id ────────────────────────────────────
# The app has no authentication yet, so the dashboard reads progress for this
# user id. Seed data creates the "detective" user with this id.
# See SUGGESTED_IMPROVEMENTS.md before deploying.
VITE_DEMO_USER_ID=2
